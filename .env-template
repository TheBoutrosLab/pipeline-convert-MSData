# Root directory containing external NFTest datasets.
DATA_DIR=/path/to/test/data/root

# NFTest temporary root. Combined with global.temp_dir from nftest.yml.
NFT_TEMP=/path/to/nftest/temp

# The shared configuration modules currently require Nextflow's v1 parser.
NXF_VER=24.10.6
NXF_SYNTAX_PARSER=v1
