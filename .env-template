# Root directory containing the ecoli_lfq and ecoli_swath test datasets.
TEST_DATA_DIR=/path/to/test/data/root

# Optional cluster: boutroslab_aws or pines. Unset uses normal test profiles.
NFT_CLUSTER=boutroslab_aws

# Base directory for test runs. AWS adds $SLURM_JOB_ID; other runs use it directly.
# If unset, defaults to the launch directory for every cluster.
NFT_RUN_ROOT=/scratch

# The shared configuration modules currently require Nextflow's v1 parser.
NXF_VER=24.10.6
NXF_SYNTAX_PARSER=v1
