import nextflow.util.SysHelper


params {
    max_cpus   = SysHelper.getAvailCpus()
    max_memory = SysHelper.getAvailMemory()
    min_cpus   = 1
    min_memory = 1.MB
    resource_allocation_profile_tag = 'default'

    // Required by pipeline-Nextflow-config's methods.set_env(). Keep false
    // outside the legacy UCLA-CDS execution environment.
    ucla_cds = false

    pwiz_version = '3.0.21258-ae984af'
    docker_image_pwiz = "chambm/pwiz-skyline-i-agree-to-the-vendor-licenses:${params.pwiz_version}"
    openms_version = '3.5.0'
    docker_image_openms = "ghcr.io/theboutroslab/openms-thirdparty:${openms_version}"
}

profiles {
    standard {
        docker.enabled = true
        apptainer.enabled = false
        singularity.enabled = false
        docker.runOptions = "-u \$(id -u):\$(id -g) \$(for i in `id --real --groups`; do echo -n \"--group-add=\$i \"; done)"
    }
    docker {
        docker.enabled = true
        apptainer.enabled = false
        singularity.enabled = false
        docker.runOptions = "-u \$(id -u):\$(id -g) \$(for i in `id --real --groups`; do echo -n \"--group-add=\$i \"; done)"
    }
    apptainer {
        docker.enabled = false
        apptainer.enabled = true
        singularity.enabled = false
        apptainer.autoMounts = true
        apptainer.ociAutoPull = true
        process {
            withName: convert_msdata_ProteoWizard {
                // Give each Wine invocation a writable copy of the image's configured prefix.
                beforeScript = {
                    def image = task.container
                    def uri = image.startsWith('/') || image.contains('://') ? image : "docker://${image}"
                    """ulimit -s 8192
                    pwiz_prefix=\$(mktemp -d "\$PWD/.wineprefix.XXXXXXXX")
                    apptainer exec --bind "\$pwiz_prefix:/mnt" '${uri}' cp -R /wineprefix64/. /mnt/
                    """
                }
                containerOptions = '--bind "$pwiz_prefix:/wineprefix64"'
            }
        }
    }
    singularity {
        docker.enabled = false
        apptainer.enabled = false
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.ociAutoPull = true
    }
}

process {
    executor = 'local'
    debug = true
    cache = true
}
