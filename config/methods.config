includeConfig "../external/pipeline-Nextflow-config/config/schema/schema.config"
includeConfig "../external/pipeline-Nextflow-config/config/methods/common_methods.config"
includeConfig "../external/pipeline-Nextflow-config/config/resource_handler/resource_handler.config"
includeConfig "../external/pipeline-Nextflow-config/config/store_object_as_json/store_object_as_json.config"

OPENMS_VALID_FORMATS = [
    'mzML', 'mzXML', 'cachedMzML', 'mgf', 'featureXML', 'consensusXML', 'edta', 'mzData',
    'dta2d', 'csv', 'sqmass'
]

PWIZ_VALID_FORMATS = ['mzML', 'mzXML', 'mgf', 'mz5', 'ms1', 'cms1', 'ms2', 'cms2']

methods {
    set_output_dir = {
        tz = TimeZone.getTimeZone("UTC")
        timestamp = new Date().format("yyyyMMdd'T'HHmmss'Z'", tz)
        software = params.convert_algorithm == 'OpenMS' ? "OpenMS-${params.openms_version}" : "ProteoWizard-${params.pwiz_version}"

        root_output_dir = "${params.output_dir}/${manifest.name}-${manifest.version}/${params.sample_id}"
        output_dir = "${root_output_dir}/${software}"
        params.final_output_dir = "${output_dir}/output"
        params.intermediate_file_dir = "${output_dir}/intermediate"

        log_dir = "${root_output_dir}/log-${manifest.name}-${manifest.version}-${timestamp}/${software}"
        params.log_output_dir = log_dir
        params.pipeline_log_dir = "${log_dir}/nextflow-log"
    }

    set_pipeline_log = {
        trace.enabled = true
        trace.file = "${params.pipeline_log_dir}/trace.txt"

        timeline.enabled = true
        timeline.file = "${params.pipeline_log_dir}/timeline.html"

        report.enabled = true
        report.file = "${params.pipeline_log_dir}/report.html"
    }

    validate = {
        // validate convert_algorithm
        if (!(params.convert_algorithm in ['OpenMS', 'ProteoWizard'])) {
            throw new Exception("Unknown params.convert_algorithm: ${params.convert_algorithm}")
        }

        def valid_output_formats = params.convert_algorithm == 'OpenMS' ? OPENMS_VALID_FORMATS : PWIZ_VALID_FORMATS
        if (!(params.output_format in valid_output_formats)) {
            throw new Exception("Invalid output_format for ${params.convert_algorithm}: ${params.output_format}")
        }

        if (!(params.containsKey('peak_picking_openms')) && !(params.containsKey('peak_picking_vendor'))) {
            params.peak_picking_openms = false
            params.peak_picking_vendor = true
        } else if (params.containsKey('peak_picking_openms') && params.containsKey('peak_picking_vendor')) {
            if (params.peak_picking_openms && params.peak_picking_vendor) {
                log.warn "Both OpenMS and vendor specific peak picking are set to true"
            }
        } else if (params.containsKey('peak_picking_openms')) {
            params.peak_picking_vendor = ! params.peak_picking_openms
        } else {
            params.peak_picking_openms = ! params.peak_picking_vendor
        }

        // Validate whether to run OpenMS peak picking.
        if (params.output_format != 'mzML') {
            if (params.containsKey('peak_picking_openms') && params.peak_picking_openms == true) {
                throw new Exception("OpenMS peak picking is not supported with output file format of ${params.output_format}")
            }
        }
    }

    setup = {
        schema.load_custom_types("${projectDir}/config/custom_schema_types.config")
        schema.validate()
        methods.set_output_dir()
        methods.set_pipeline_log()
        methods.validate()
        resource_handler.handle_resources("${projectDir}/config/resources.json")
        methods.set_env()
        methods.configure_containerization()
        methods.setup_process_afterscript()

        json_extractor.store_object_as_json(
            params,
            new File("${params.pipeline_log_dir}/params.json")
        )
    }
}
