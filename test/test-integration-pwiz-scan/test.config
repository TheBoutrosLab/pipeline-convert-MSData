includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"

def csvEnvironmentExpander = evaluate(new File("${projectDir}/test/csv_environment_expander.groovy"))

params {
    input_csv = "${projectDir}/test/test-integration-pwiz-scan/input.csv"
    output_dir = ""
    sample_id = 'SBP0001'
    output_format = 'mzML'
    save_intermediate_files = true
    convert_algorithm = 'ProteoWizard'
    peak_picking_vendor = true
    peak_picking_openms = false
    pwiz_extra_args = '--64 --zlib --ignoreUnknownInstrumentError'
}

params.input_csv = csvEnvironmentExpander.prepareInputCsv(params.input_csv, 'test-integration-pwiz-scan', launchDir)
methods.setup()
