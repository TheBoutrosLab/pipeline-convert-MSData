includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"

def csvEnvironmentExpander = evaluate(new File("${projectDir}/test/csv_environment_expander.groovy"))

params {
    input_csv = "${projectDir}/test/test-integration-custom-cpus/input.csv"
    sample_id = 'SBP0001'
    output_dir = ""
    output_format = 'mzML'
    save_intermediate_files = true
    peak_picking_vendor = false
    peak_picking_openms = true
    pick_peaks_cpus = 6
}

params.input_csv = csvEnvironmentExpander.prepareInputCsv(params.input_csv, 'test-integration-custom-cpus', launchDir)
methods.setup()
